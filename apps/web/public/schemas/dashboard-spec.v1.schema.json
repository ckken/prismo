{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ckken.github.io/shadcnagent/schemas/dashboard-spec.v1.schema.json",
  "title": "DashboardSpec v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "request",
    "intent",
    "widgets",
    "dataMode",
    "tableLevel",
    "states",
    "unresolved"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "request": { "type": "string", "minLength": 1 },
    "intent": {
      "enum": ["overview", "sales", "commerce", "agent-operations", "crm", "finance", "unknown"]
    },
    "widgets": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["metric-grid", "trend-chart", "data-table"] }
    },
    "dataMode": { "enum": ["client", "server", "unknown"] },
    "tableLevel": { "enum": ["L0", "L1", "L2", "unknown"] },
    "states": {
      "const": ["success", "loading", "empty", "contract-error"]
    },
    "unresolved": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
